; LifeVerse desktop client - Godot 4.7.2 .NET
config_version=5

[application]
config/name="LifeVerse"
config/icon="res://Assets/brand/icon.png"
run/main_scene="res://Scenes/Bootstrap.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]
AppManager="*res://Autoloads/AppManager.cs"
SessionManager="*res://Autoloads/SessionManager.cs"
NetworkManager="*res://Autoloads/NetworkManager.cs"
NetworkBridge="*res://Autoloads/NetworkBridge.cs"
AuthManager="*res://Autoloads/AuthManager.cs"
UIManager="*res://Autoloads/UIManager.cs"
AvatarManager="*res://Autoloads/AvatarManager.cs"
ClientSettings="*res://Autoloads/ClientSettings.cs"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="LifeVerse.Client"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
terrain_mode={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":84)]}
strafe_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
strafe_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":90)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
run={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
fly_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
descend={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326)]}
first_person={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
camera_mode={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":86)]}
camera_reset={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
cursor_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194328)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
emote_wave={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
emote_dance={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":72)]}
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
build_mode={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":66)]}

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.8

[audio]

driver/enable_input=true
