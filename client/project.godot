; LifeVerse desktop client - Godot 4.7.2 .NET
config_version=5

[application]
config/name="LifeVerse"
run/main_scene="res://Scenes/Bootstrap.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]
AppManager="*res://Autoloads/AppManager.cs"
SessionManager="*res://Autoloads/SessionManager.cs"
NetworkManager="*res://Autoloads/NetworkManager.cs"
AuthManager="*res://Autoloads/AuthManager.cs"
UIManager="*res://Autoloads/UIManager.cs"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.8
