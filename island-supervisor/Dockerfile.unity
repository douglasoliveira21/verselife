# Island server image with the UNITY dedicated server (LifeVerse Wire 12) instead of the Godot one: the same supervisor starts one island process
# per island that players are waiting for, but the process is LifeVerseServer.x86_64 (SUPERVISOR_ENGINE=unity).
#
# The Unity Linux player needs glibc (Debian/Ubuntu); it does NOT run on Alpine. This base image is Debian.
#
# 1. Build the Linux server (Unity 6000.6.9f1 with the Linux Dedicated Server module), from the repository root:
#      powershell -File unity/UnityPlugins/build-plugins.ps1
#      Unity.exe -batchmode -nographics -projectPath unity/UnityClient -executeMethod LifeVerse.Unity.EditorTools.BuildClient.BuildLinuxServer
#    The result is unity/UnityClient/Builds/LinuxServer (not in git; the Docker context must contain it).
# 2. Build the image from the repository root:
#      docker build -f island-supervisor/Dockerfile.unity -t lifeverse-islands-unity .
#
# NOT TESTED as an image (no Docker here). Tested on Ubuntu 26.04 (WSL 2): the supervisor published for linux-x64 starts this exact server, the server answers
# the health check, serves 64 UDP clients and stops cleanly on SIGTERM. If the first start in a slim container fails with a missing shared library, add it below.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS supervisor
WORKDIR /src
COPY Directory.Build.props ./
COPY island-supervisor/ island-supervisor/
RUN dotnet publish island-supervisor/LifeVerse.IslandSupervisor.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/runtime:8.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=supervisor /out /opt/supervisor
COPY unity/UnityClient/Builds/LinuxServer/ /opt/lifeverse-server/
RUN chmod +x /opt/lifeverse-server/LifeVerseServer.x86_64 && rm -rf /opt/lifeverse-server/*BackUpThisFolder_ButDontShipItWithYourGame

ENV SUPERVISOR_ENGINE=unity \
    SUPERVISOR_UNITY_SERVER_PATH=/opt/lifeverse-server/LifeVerseServer.x86_64 \
    SUPERVISOR_PORT_START=7777 \
    SUPERVISOR_MAX_ISLANDS=8 \
    SUPERVISOR_IDLE_MINUTES=10
# The Unity server accepts the entry tickets the API issues today (protocol 11) by default; see LIFEVERSE_TICKET_PROTOCOL.
# One UDP port per island that can run at once (SUPERVISOR_PORT_START + SUPERVISOR_MAX_ISLANDS - 1); the health ports (TCP 7070...) stay inside the container.
EXPOSE 7777-7784/udp
WORKDIR /opt/supervisor
ENTRYPOINT ["dotnet", "/opt/supervisor/LifeVerse.IslandSupervisor.dll"]
