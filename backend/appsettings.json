{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=lifeverse;Username=lifeverse;Password=development-only",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "lifeverse-api",
    "Audience": "lifeverse-client",
    "SigningKey": "CONFIGURE-A-SECRET-OF-AT-LEAST-32-CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "IslandServer": { "SharedKey": "CONFIGURE-A-SEPARATE-SERVICE-SECRET" },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "FormatterName": "json" }
  }
}
