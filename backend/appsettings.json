{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=lifeverse;Username=lifeverse;Password=development-only",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "lifeverse-api",
    "Audience": "lifeverse-client",
    "SigningKey": "CONFIGURE-A-SECRET-OF-AT-LEAST-32-CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "IslandServer": { "SharedKey": "CONFIGURE-A-SEPARATE-SERVICE-SECRET" },
  "IslandEntry": {
    "Issuer": "lifeverse-api",
    "Audience": "lifeverse-island-server",
    "SigningKey": "CONFIGURE-A-SEPARATE-ENTRY-TOKEN-SECRET",
    "LifetimeSeconds": 45,
    "ProtocolVersion": 1
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "lifeverse-assets",
    "LocalRoot": "asset-data"
  },
  "LuaRuntime": {
    "WorkerPath": "lua",
    "TimeoutMilliseconds": 250,
    "MaxSourceBytes": 65536,
    "MaxInstructions": 10000,
    "MaxMemoryKb": 256,
    "MaxEventsPerSecond": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "FormatterName": "json" }
  }
}
