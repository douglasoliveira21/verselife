<Project>
  <!-- obj próprio: os dois projetos estão na mesma pasta e dividiriam o project.assets.json (cada restauração apagaria os pacotes do outro) -->
  <PropertyGroup><BaseIntermediateOutputPath>obj\scripting\</BaseIntermediateOutputPath></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!-- Compila o código-fonte de ../../scripting (runtime Lua com MoonSharp) para a Unity, sem alterar o projeto original. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LifeVerse.Scripting</AssemblyName>
    <!-- PackageId próprio: o NuGet identifica projetos por este nome, e dois projetos 'LifeVerse.Scripting' (este e o original) se confundiam no restore de quem os referencia por caminhos diferentes (o Host .NET recebia a DLL da Unity) -->
    <PackageId>LifeVerse.Scripting.Unity</PackageId>
    <RootNamespace>LifeVerse.Scripting</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>bin\LifeVerse.Scripting.Unity\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);LIFEVERSE_UNITY_PLUGIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="generated\scripting\**\*.cs" />
    <Compile Include="Polyfills.cs" />
    <Compile Include="Compat.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
