<Project Sdk="Microsoft.NET.Sdk">
  <!-- Clientes de carga: N jogadores simulados por UDP contra um servidor de ilha em execução (Host .NET ou Unity Dedicated Server). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LifeVerse.IslandServer.LoadTest</AssemblyName>
    <RootNamespace>LifeVerse.IslandServer.LoadTest</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\UnityWire\LifeVerse.Wire.csproj" />
    <ProjectReference Include="..\..\..\shared\LifeVerse.Shared.csproj" />
  </ItemGroup>
</Project>
