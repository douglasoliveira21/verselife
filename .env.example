# Copy to .env. Never commit real secrets.
POSTGRES_DB=lifeverse
POSTGRES_USER=lifeverse
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_ISSUER=lifeverse-api
JWT_AUDIENCE=lifeverse-client
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
MINIO_ROOT_USER=lifeverse
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=lifeverse-assets
ISLAND_SERVER_SHARED_KEY=replace-with-a-long-random-service-key
ISLAND_ENTRY_SIGNING_KEY=replace-with-an-independent-32-character-signing-key
LIFEVERSE_SNAPSHOT_RATE=20
LIFEVERSE_MAX_PLAYERS=64
LIFEVERSE_INTEREST_RADIUS=100
LIFEVERSE_CHAT_BLOCKED_TERMS=
LIFEVERSE_ISLAND_ID=replace-with-an-existing-island-uuid
LIFEVERSE_INSTANCE_ID=11111111-1111-1111-1111-111111111111
LIFEVERSE_PUBLIC_HOSTNAME=127.0.0.1
LIFEVERSE_GAME_PORT=7777
LIFEVERSE_HEALTH_PORT=7070
LIFEVERSE_LUA_WORKER=lua
API_HTTP_PORT=8080
